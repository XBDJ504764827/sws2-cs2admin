{
  "sws2-cs2admin": {
    "Debug": false,
    // Also accept admin nodes granted through SwiftlyS2's permissions.jsonc.
    "UseSwiftlyPermissions": true,
    // Fallback immunity for admins without a group/direct immunity.
    "DefaultImmunity": 0,
    "Bans": {
      "CheckOnJoin": true,
      // 0 = permanent
      "DefaultDurationMinutes": 0,
      // 0 = no limit
      "MaxDurationMinutes": 525600,
      "AllowUnban": true,
      "KickMessage": "Banned: {0} ({1})"
    },
    "Comms": {
      "EnforceGag": true,
      "DefaultDurationMinutes": 30,
      "MaxDurationMinutes": 0,
      "ExpireCheckSeconds": 30
    },
    "Audit": {
      "Enabled": true,
      "RetentionDays": 30
    },
    "Menu": {
      "PageSize": 5
    },
    "Maps": {
      // Map list for the map management menu. Other plugins can query this through IMapListService.
      // Supports map names and Workshop IDs.
      "Available": [
        "de_dust2",
        "de_inferno",
        "de_mirage",
        "de_ancient",
        "de_nuke",
        "de_anubis",
        "de_overpass"
      ]
    },
    "Notify": {
      "OnlineAdmins": false,
      "BroadcastBans": false,
      // Show map changes to everyone.
      "BroadcastMapChanges": true
    }
  }
}
